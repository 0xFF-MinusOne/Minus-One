{
  "name": "pentest-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8092 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "setup:dev": "node scripts/setup-dev.mjs",
    "gen:types": "supabase gen types typescript --local > src/lib/database.types.ts",
    "dev:totp": "node scripts/dev-totp.mjs",
    "members": "node scripts/manage-members.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore-backup.mjs",
    "mcp:build": "esbuild mcp/src/main.ts --bundle --platform=node --format=esm --packages=external --log-level=warning --outfile=mcp/dist/server.mjs",
    "mcp:bot": "node scripts/setup-mcp-bot.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@supabase/supabase-js": "2.118.0",
    "@tanstack/react-query": "5.105.3",
    "lucide-react": "1.67.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "2.15.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "esbuild": "0.25.12",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  }
}
